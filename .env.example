# ---- Phoenix AI DATA API (서버 전용. 브라우저 번들에 절대 넣지 않는다) ----
# 발급: https://openapi.chickstockfi.com/request?product=builder (행사 코드 OBS2) → 포털 로그인 → DATA 키 생성
# ck_live_ 로 시작. 비어 있으면 앱은 "샘플 데이터" 모드로 동작한다 (화면에 샘플 표시).
PHOENIX_DATA_KEY=

# ---- Vapi (브라우저용 Public key만. Private key는 절대 넣지 않는다) ----
# 발급: https://dashboard.vapi.ai/?coupon-code=obavapi26 (행사 크레딧 $20) → Organization Settings → API Keys → Public key
# 비어 있으면 음성 통화 대신 브라우저 TTS로 첫 마디만 들려주는 "듣기 모드"로 동작한다.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# 선택. 대시보드에서 assistant를 만들어 ID를 넣으면 그 설정 위에 종목 데이터를 overrides로 얹는다.
# 비어 있으면 코드 안의 임시(transient) assistant로 통화한다 (권장: 비워 두기).
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# 선택. 한국어 TTS 공급자: azure(기본, ko-KR 신경망 InJoon) | 11labs(flash v2.5) | openai(gpt-4o-mini-tts, 실측 실패). URL ?tts= 가 우선
NEXT_PUBLIC_VAPI_TTS=
# 선택. 공급자별 voiceId 덮어쓰기 (openai: noeul·nuri·ash… / azure: ko-KR-InJoonNeural·ko-KR-SunHiNeural / 11labs: sarah·ryan…). URL ?voice= 가 우선
NEXT_PUBLIC_VAPI_VOICE_ID=
# 선택. 한국어 STT 공급자: 11labs(기본, scribe_v2_realtime) | openai(gpt-4o-transcribe) | azure(ko-KR) | deepgram(nova-3)
# 전부 Vapi 크레딧으로 쓰는 내장 공급자라 별도 키 불필요.
NEXT_PUBLIC_VAPI_TRANSCRIBER=
